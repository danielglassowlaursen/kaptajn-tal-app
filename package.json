{
  "name": "kaptajn-tal-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "wrangler dev --port 8787",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.worker.json",
    "build": "pnpm typecheck && pnpm test && vite build",
    "preview": "vite preview",
    "deploy": "pnpm build && wrangler deploy",
    "db:init": "wrangler d1 execute kaptajn-tal-app --remote --file worker/schema.sql -y",
    "db:init:local": "wrangler d1 execute kaptajn-tal-app --local --file worker/schema.sql -y",
    "deploy:mine": "pnpm build && wrangler deploy -c wrangler.local.jsonc",
    "db:init:mine": "wrangler d1 execute kaptajn-tal-app --remote -c wrangler.local.jsonc --file worker/schema.sql -y",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261009.1",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "fast-check": "^4.10.2",
    "typescript": "^5.8.0",
    "vite": "^6.3.0",
    "vitest": "^5.0.4",
    "wrangler": "4.152.0"
  },
  "license": "SEE LICENSE IN LICENSE.md"
}
