{
  // Cloudflare Worker (API til familiekode-synk) + statiske filer fra dist/.
  // Opsætning: se README, afsnittet "Kør din egen kopi".
  "name": "kaptajn-tal-app",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-06",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kaptajn-tal-app",
      // Indsæt id'et fra: npx wrangler d1 create kaptajn-tal-app
      "database_id": "INDSÆT-DIT-DATABASE-ID"
    }
  ],
  "r2_buckets": [
    {
      "binding": "ARK",
      // Opret med: npx wrangler r2 bucket create kaptajn-tal-app-ark
      "bucket_name": "kaptajn-tal-app-ark"
    }
  ],
  "observability": { "enabled": true }
}
