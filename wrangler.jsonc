{
  // Cloudflare Worker (API til familiekode-synk) + statiske filer fra dist/.
  // Opsætning: se README, afsnittet "Kør din egen kopi".
  "name": "kaptajn-tal-app",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-06",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kaptajn-tal-app"
    }
  ],
  "r2_buckets": [
    {
      "binding": "ARK",
      // Opret med: npx wrangler r2 bucket create kaptajn-tal-app-ark
      "bucket_name": "kaptajn-tal-app-ark"
    }
  ],
  "rules": [{ "type": "Text", "globs": ["**/*.sql"], "fallthrough": true }],
  // Grænser pr. minut (Cloudflare Rate Limiting). Fjern blokken for at slå dem fra.
  "ratelimits": [
    { "name": "API_LIMIT", "namespace_id": "1001", "simple": { "limit": 300, "period": 60 } },
    { "name": "GAET_LIMIT", "namespace_id": "1002", "simple": { "limit": 20, "period": 60 } },
    { "name": "SCAN_LIMIT", "namespace_id": "1003", "simple": { "limit": 5, "period": 60 } }
  ],
  "observability": { "enabled": true }
}
